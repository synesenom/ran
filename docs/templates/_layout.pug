doctype html
html(lang="en", data-ranjs-channel=channel)
    head
        meta(charset="utf-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        link(rel="icon", type="image/svg+xml", href="assets/ran.svg")
        link(rel="icon", type="image/svg+xml", href="assets/ran-white.svg", media="(prefers-color-scheme: dark)")
        link(rel="icon", type="image/png", sizes="256x256", href="assets/ran-256.png")
        link(rel="icon", type="image/png", sizes="256x256", href="assets/ran-white.png", media="(prefers-color-scheme: dark)")
        link(rel="preconnect", href="https://fonts.googleapis.com")
        link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
        link(href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap", rel="stylesheet")
        link(rel="stylesheet", type="text/css", href="styles/style.css")
        title #{name}
    body
        div#ranjs-version-banner.version-banner(hidden)
        div.top
            img.mark(src="assets/ran.svg", alt="然")
            span.nm
                | ran
                b js
            select#ranjs-version-select.version-select(aria-label="Documentation version")
            a.version-notes-link(href=releaseNotesUrl, target="_blank", rel="noopener") notes
            nav
                if pages && pages.length > 1
                    each pg in pages
                        a(href=pg.output, class=(pg.output === currentPage ? 'active' : ''))= pg.navLabel
                a.icon-github(href="https://github.com/synesenom/ran", target="_blank", rel="noopener", aria-label="GitHub", title="GitHub")
                    svg(viewBox="0 0 16 16", width="18", height="18", fill="currentColor", aria-hidden="true")
                        path(d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z")
        block sidebar
        main
            block content
            block scripts
        script(src="assets/version-switcher.js", defer)
