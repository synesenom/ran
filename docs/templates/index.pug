extends _layout

block sidebar
    input(id="menu", type="checkbox")
    label.menu-button(for="menu") ☰
    label.menu-overlay(for="menu")
    aside
        .search-bar
            input#search(type="search", placeholder="search")
        ul.sections
            each section in menu
                li
                    label(id="toc-" + section.name, for="" + section.name) #{section.name}
                    input(type="checkbox", id="" + section.name)
                    ul.methods
                        each member in section.members
                            li.toc-entry(id="toc-" + member.index)
                                a(href="#" + member.index) #{member.name}

block content
    .hero
        img.mark(src="assets/ran.svg", alt="然 rán")
        div
            h1 ranjs
            p.sub
                | #[span.zh rán · 然] #[span.gloss &ldquo;so; correct&rdquo;] &mdash; robust random variates, distribution testing &amp; statistics for JavaScript.

    h2 Install in node
    pre.install
        code.hljs !{install.node}

    h2 Use in browser
    pre.install
        code.hljs !{install.browser}

    h2 Demo
    p
        | #[a(href="https://observablehq.com/d/bb01e148548b6ef9", target="_blank") Continuous distributions] &middot; #[a(href="https://observablehq.com/d/b2f210c305445d4e", target="_blank") Discrete distributions]

    h2 API
    each entry in api
        .card(class=entry.deprecated ? 'deprecated' : '', data-index=entry.index)
            if entry.deprecated
                .deprecated-banner.margined
                    span.deprecated-label Deprecated
                    span.deprecated-message !{entry.deprecated}
            pre.title(id="" + entry.index) #{entry.signature}
            // if entry.source
                a.source-link(href=entry.source, target="_blank", rel="noopener noreferrer") source
            .desc.margined !{entry.desc}
            if entry.params
                h3 Parameters
                table.margined
                    thead
                        tr
                            th Name
                            th.param-type Type
                            th.param-desc Description
                    tbody
                        each param in entry.params
                            tr
                                td.param-name(style=`padding-left: ${1 + param.depth * 1.25}em`) #{param.name}
                                td.param-type
                                    each type in param.type
                                        code.type #{type}
                                td.param-desc !{param.desc}
            if entry.returns
                h3 Returns
                .returns.margined
                    .return-type
                        each type in entry.returns.type
                            code.type #{type}
                    .return-desc !{entry.returns.desc}
            if entry.throws
                h3 Throws
                .throws.margined
                    each exception in entry.throws
                        .throws-entry
                            .throws-type
                                  code.type #{exception.type}
                            .throws-desc !{exception.desc}
            if entry.examples
                h3 Examples
                pre
                    code.example.hljs !{entry.examples}
            if entry.sees
                h3 References
                ul.margined
                    each see in entry.sees
                        li !{see}

block scripts
    script.
        // List of entries.
        const list = JSON.parse('!{searchList}');

        // Bind search to the search input change.
        document.getElementById("search").addEventListener("input", function () {
          // Find names containing the search keyword.
          const token = this.value.toLowerCase();
          const matches = new Set(
            list.filter(d => d.split('.').slice(-1)[0].toLowerCase().indexOf(token) > -1)
          );

          // Sidebar entries and their content cards share the same `index`
          // (toc-entry id is `toc-`-prefixed, the card's is bare), so both
          // are filtered from the same match set — search narrows the page
          // itself, not just the nav.
          Array.from(document.getElementsByClassName('toc-entry')).forEach(entry => {
            entry.style.display = matches.has(entry.id.slice('toc-'.length)) ? 'block' : 'none';
          });
          Array.from(document.getElementsByClassName('card')).forEach(card => {
            card.style.display = matches.has(card.dataset.index) ? '' : 'none';
          });

          // Hide a whole section (its header + list) once none of its
          // entries match, the way lodash's docs sidebar search does.
          document.querySelectorAll('ul.sections > li').forEach(section => {
            const hasMatch = Array.from(section.getElementsByClassName('toc-entry'))
              .some(entry => entry.style.display !== 'none');
            section.style.display = hasMatch ? '' : 'none';
          });
        });
